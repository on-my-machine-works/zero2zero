#!/usr/bin/env python3
"""z2zd BLE RPC & Offload Daemon entrypoint."""

from pathlib import Path
import sys

for cand in (
    Path(__file__).resolve().parents[1] / "python",
    Path("/usr/lib/zero2zero/python"),
):
    if (cand / "z2z").is_dir():
        sys.path.insert(0, str(cand))
        break

from z2z.daemon import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
